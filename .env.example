# AISSeaStats settings. install.sh creates .env from this file with random passwords.

# Port of the statistics page on the host: http://<pi-ip>:8095
AISSEASTATS_PORT=8095

# Default time zone (can be changed later in the admin page)
TZ=Europe/Paris

# Database passwords — use long random values
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Optional: only accept AIS-catcher data from these networks (comma separated CIDRs).
# Leave empty to rely on the ingestion token alone.
INGEST_ALLOW=
